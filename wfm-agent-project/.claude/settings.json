{
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(*.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(*.env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/../venv/Scripts/python.exe",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run_tests.py"],
            "timeout": 300,
            "statusMessage": "Running pytest..."
          }
        ]
      }
    ]
  }
}
